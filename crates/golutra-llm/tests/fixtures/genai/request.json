{
  "path": "/chat/completions",
  "body": {
    "max_tokens": 128,
    "messages": [
      {"role": "system", "content": "You are concise."},
      {"role": "user", "content": "Read the project file."},
      {
        "role": "assistant",
        "content": "",
        "tool_calls": [
          {
            "id": "call-read-1",
            "type": "function",
            "function": {
              "name": "read_file",
              "arguments": "{\"path\":\"README.md\"}"
            }
          }
        ]
      },
      {
        "role": "tool",
        "tool_call_id": "call-read-1",
        "content": "{\"summary\":\"project file read\"}"
      },
      {"role": "user", "content": "Summarize it."}
    ],
    "model": "deepseek-chat",
    "stream": false,
    "tools": [
      {
        "type": "function",
        "function": {
          "name": "read_file",
          "description": "Read workspace lines; use offset/limit and continuation.next_offset.",
          "parameters": {
            "type": "object",
            "properties": {"path": {"type": "string"}},
            "required": ["path"]
          },
          "strict": false
        }
      }
    ]
  }
}
