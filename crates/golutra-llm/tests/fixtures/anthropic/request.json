{
  "path": "/v1/messages",
  "body": {
    "max_tokens": 128,
    "messages": [
      {"role": "user", "content": "Read the project file."},
      {
        "role": "assistant",
        "content": [
          {
            "type": "tool_use",
            "id": "call-read-1",
            "name": "read_file",
            "input": {"path": "README.md"}
          }
        ]
      },
      {
        "role": "user",
        "content": [
          {
            "type": "tool_result",
            "tool_use_id": "call-read-1",
            "content": "{\"summary\":\"project file read\"}"
          }
        ]
      },
      {"role": "user", "content": "Summarize it."}
    ],
    "model": "claude-test",
    "stream": false,
    "system": [
      {
        "type": "text",
        "text": "You are concise.",
        "cache_control": {"type": "ephemeral", "ttl": "5m"}
      }
    ],
    "tools": [
      {
        "name": "read_file",
        "description": "Read a UTF-8 workspace file by line window; use offset/limit and continuation.next_offset for more.",
        "input_schema": {
          "type": "object",
          "properties": {"path": {"type": "string"}},
          "required": ["path"]
        }
      }
    ]
  }
}
