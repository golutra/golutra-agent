{
  "manifest_version": 3,
  "name": "Golutra Browser Connector",
  "version": "0.4.0",
  "minimum_chrome_version": "125",
  "description": "Automatically connect the local Golutra Agent and create task tabs using this Chrome profile.",
  "key": "",
  "permissions": ["activeTab", "tabs", "debugger", "nativeMessaging", "storage", "downloads", "alarms"],
  "background": {"service_worker": "background.js", "type": "module"},
  "action": {"default_popup": "popup.html", "default_title": "Golutra 浏览器连接"}
}
